# Frontend Environment Configuration
# Copy this file to .env.local and update with your values

# Supabase Configuration
VITE_SUPABASE_URL=https://ltqohdqdakytyxnlqzog.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ESP32 Endpoint (update with your ESP32 IP address)
VITE_WATER_ENDPOINT=http://10.0.0.200/water-now

# Hosted Read-Only Dashboard Mode
# Cloudflare Pages should use VITE_MBG_DASHBOARD_MODE=hosted-readonly
# for the hosted read-only deployment.
VITE_MBG_DASHBOARD_MODE=

# Single device shown by the Phase 6A hosted read-only MVP.
# Future multi-device read-only selection should use separate approved
# UI/config work, not remote control.
VITE_MBG_DEVICE_ID=
