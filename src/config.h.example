#ifndef CONFIG_H
#define CONFIG_H

// WiFi Configuration
#define WIFI_SSID "your_wifi_ssid"
#define WIFI_PASSWORD "your_wifi_password"

// Supabase Configuration. Use the HTTPS project root only; firmware appends
// /rest/v1/<table> for each approved Data API write target.
#define SUPABASE_URL "https://your_project.supabase.co"
#define SUPABASE_ANON_KEY "your_supabase_anon_key"

// Device identity and firmware provenance are supplied by the explicit
// PlatformIO device environment, not by this local secrets file.

// Timing Configuration
#define WATERING_DURATION_MS 15000
#define MOISTURE_THRESHOLD 35

// NTP Configuration
#define NTP_SERVER1 "pool.ntp.org"
#define NTP_SERVER2 "time.nist.gov"
#define TIMEZONE "EST5EDT,M3.2.0,M11.1.0"

#endif // CONFIG_H
